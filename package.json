    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^25.0.1",
    "sass": "^1.83.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
